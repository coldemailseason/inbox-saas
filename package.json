{
  "name": "inbox-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:studio": "turbo run db:studio -F @inbox-saas/db --",
    "db:generate": "turbo run db:generate -F @inbox-saas/db --",
    "db:migrate": "turbo run db:migrate -F @inbox-saas/db --",
    "db:start": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres",
    "db:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up postgres",
    "db:stop": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml rm -sf postgres",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "docker:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml build",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@inbox-saas/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inbox-saas/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.5.2"
}
