# Real tenant-validation worker configuration.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/inbox-saas
# Base64-encoded 32-byte key used to decrypt tenant administrator credentials.
TENANT_CREDENTIAL_ENCRYPTION_KEY=
# Version identifier for the tenant credential encryption key.
TENANT_CREDENTIAL_ENCRYPTION_KEY_VERSION=
# Private provisioner URL. Use http://127.0.0.1:8000 when the provisioner runs natively.
PROVISIONER_BASE_URL=http://127.0.0.1:8000
# Base64-encoded cryptographically random 32-byte key shared with the private provisioner.
# Generate with: openssl rand -base64 32
INBOX_PROVISIONER_SIGNING_SECRET=
# Separate base64-encoded cryptographically random 32-byte AES-256-GCM transport key.
# Generate with: openssl rand -base64 32
INBOX_PROVISIONER_TRANSPORT_ENCRYPTION_KEY=
