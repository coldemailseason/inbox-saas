{
  "name": "worker",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.mjs",
    "dev:fake": "tsx watch src/fake-main.ts",
    "start:fake": "node dist/fake-main.mjs",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "SKIP_ENV_VALIDATION=1 vitest run test/integration"
  },
  "dependencies": {
    "@inbox-saas/db": "workspace:*",
    "@inbox-saas/product": "workspace:*",
    "@inbox-saas/provisioner-contract": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.22.4",
    "pg-boss": "^12.29.0"
  },
  "devDependencies": {
    "@inbox-saas/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
